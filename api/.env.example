APP_NAME="Teint d'Afrique API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://teintdafrique.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base de donnees (les anciens noms DB_NAME/DB_USER/DB_PASS sont aussi acceptes)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teint_afrique_cms
DB_USERNAME=root
DB_PASSWORD=

# Sessions admin (cookie conserve depuis l'ancienne API PHP)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=tda_admin_session
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Premier compte admin (utilise par "php artisan teint:seed" si aucun admin)
ADMIN_EMAIL=admin@teintdafrique.com
ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Emails (transport smtp recommande ; "log" en developpement)
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.votre-hebergeur.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@teintdafrique.com"
MAIL_FROM_NAME="Teint d'Afrique Cosmetiques"
MAIL_NOTIFY_TO=

# Origines autorisees pour le CORS (liste separee par des virgules).
# Vide = seules les requetes same-origin (proxy Vite) sont acceptees.
CORS_ORIGINS=
